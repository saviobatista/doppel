# Kortes (doppel-api) - environment template. Copy to .env and fill the real
# secrets. Never commit the real .env (it is gitignored). Every field has a safe
# default in config.py, so the app boots even with keys missing - each provider
# just degrades to empty/skipped. Keys shown commented document their default.

# =====================================================================
# Managed AI providers (fill these - real keys)
# =====================================================================
ANTHROPIC_API_KEY=sk-ant-...
ELEVENLABS_API_KEY=...
FAL_KEY=...
# Real-media sourcing + research (SerpAPI: Google / Images / YouTube). Without
# it, research and real-image search return empty and everything falls back to
# generation (no real photos or footage). Strongly recommended for the Video Agent.
SERPAPI_KEY=...
# Optional extra voice-clone provider for the candidate A/B (empty -> slot skipped).
# FISH_API_KEY=...

# =====================================================================
# Models (sane defaults in config.py; override only to change behavior)
# =====================================================================
# ANTHROPIC_MODEL=claude-sonnet-4-6              # script + research-query author
# ANTHROPIC_PLANNER_MODEL=claude-sonnet-4-6      # video-plan author (fast, no truncation)
# ANTHROPIC_PROMPT_MODEL=claude-opus-4-7         # face-attribute extraction / identity lock
# ANTHROPIC_RESEARCH_MODEL=claude-opus-4-8       # web-search research step
# ELEVENLABS_MODEL=eleven_multilingual_v2
# FAL_LIPSYNC_MODEL=veed/fabric-1.0
# FAL_BROLL_MODEL=fal-ai/kling-video/v2.1/standard/image-to-video
# FAL_T2I_MODEL=fal-ai/flux/schnell
# FAL_EDIT_MODEL=fal-ai/bytedance/seedream/v4.5/edit
# FAL_MUSIC_MODEL=fal-ai/stable-audio-3/medium/text-to-audio

# =====================================================================
# Drivers / tunables (defaults shown)
# =====================================================================
# Research backend: serpapi_rest (default, ~4s) | claude_mcp (~100s) | anthropic
# RESEARCH_MODE=serpapi_rest
# Avatar-look text-to-image: fal (managed FLUX schnell) | flux2 (self-hosted
# FLUX.2 on the Starya inference cluster, in-cluster only).
# BROLL_T2I_DRIVER=fal
# BROLL_FLUX_API_BASE=http://flux2-klein-9b.eks-inference-stack.svc.cluster.local:8000
# Avatar-card looks: seedream (fal image edit) | flux2 | none.
# AVATAR_LOOKS_DRIVER=seedream
# AVATAR_LOOKS_COUNT=3
# AVATAR_CARD_LOOKS=2
# Generation seam (plan_generate) - swap implementations per capability:
# TTS_DRIVER=elevenlabs                          # only driver today
# LIPSYNC_DRIVER=fabric                          # fabric (fal) | none
# I2V_DRIVER=kenburns                            # kenburns (ffmpeg) | kling (fal) | selfhosted
# MUSIC_DRIVER=elevenlabs                        # preferred materialized music candidate
# T2I_DRIVER=fal                                 # still gen for b-roll w/o scraped media
# MUSIC_GAIN=0.22                                # music bed gain (linear)
# Media / quality:
# MEDIA_VISION_SELECT=true                       # Claude vision picks best scraped image
# MEDIA_MIN_DIMENSION=900                        # min short-side px for scraped stills
# YOUTUBE_SHORTS_COUNT=2                         # real footage links per plan (0 disables)
# PIPELINE_CONCURRENCY=4
# VIDEO_TARGET_SECONDS=10
# CAPTION_FONT="DejaVu Sans"                     # quote values with spaces

# =====================================================================
# Infrastructure - docker-compose injects these for api + stub-worker.
# Set them only when running the backend OUTSIDE compose.
# =====================================================================
# DOPPEL_DATABASE_URL=postgresql+asyncpg://doppel:doppel@localhost:5432/doppel
# DOPPEL_REDIS_URL=redis://localhost:6379/0
# DOPPEL_S3_ENDPOINT=http://localhost:4566
# DOPPEL_S3_PUBLIC_ENDPOINT=http://localhost:4566  # browser-reachable presign endpoint
# DOPPEL_S3_BUCKET=doppel-media
# DOPPEL_S3_REGION=us-east-1
# DOPPEL_CORS_ORIGINS=http://localhost:3100,http://localhost:3000
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# AWS_DEFAULT_REGION=us-east-1
# CACHE_DIR=/app/cache

# Dev note: presigned URLs point at http://floci:4566. To open them from the
# browser, add once to /etc/hosts:  127.0.0.1 floci
