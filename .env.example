# --- Frontend (vite) ---
VITE_API_URL=http://localhost:8200

# --- Backend (uvicorn local, outside compose) ---
DOPPEL_LOG_LEVEL=INFO
DOPPEL_DATABASE_URL=postgresql+asyncpg://doppel:doppel@localhost:5432/doppel
DOPPEL_REDIS_URL=redis://localhost:6379/0
DOPPEL_S3_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# --- Managed providers (real keys; never commit the real .env) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
ELEVENLABS_API_KEY=...
ELEVENLABS_MODEL=eleven_multilingual_v2
# --- Self-hosted inference (Starya cluster via LiteLLM ALB) ---
INFERENCE_API_KEY=...
# Dev from outside EKS (defaults in Settings point at ALB /latentsync and /cosmos3):
# AVATAR_API_BASE=http://k8s-eksinferencestack-7ea3c82c23-2009427571.us-east-1.elb.amazonaws.com/latentsync
# BROLL_API_BASE=http://k8s-eksinferencestack-7ea3c82c23-2009427571.us-east-1.elb.amazonaws.com/cosmos3
# BROLL_FAST_STEPS=30
# BROLL_FAST_FPS=24
# BROLL_FAST_SIZE=480x832
# AVATAR_GUIDANCE_SCALE=1.5
# AVATAR_INFERENCE_STEPS=20
# Quote values with spaces so .env parsers (uv --env-file) don't choke.
# Both have safe defaults in Settings, so you may also just omit them.
CAPTION_FONT="DejaVu Sans"
PIPELINE_CONCURRENCY=4

# SUPABASE_* are intentionally unused in this iteration (Postgres + floci stay).

# Browser access to presigned URLs (dev): presigns point at http://floci:4566.
# Add to /etc/hosts once:  127.0.0.1 floci
